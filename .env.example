# Server-only provider settings. Keep real values out of git and chat.
# Optional error monitoring. Disabled unless enabled=true AND your own DSN is set.
# Browser settings are public and are fixed when the app is built.
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
# Server error telemetry; messages and request/user data are removed.
SENTRY_DSN=
SENTRY_ENABLED=false

# Qwen / Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional Grok fallback
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Bright Data
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=web_unlocker1

# Daytona policy sandbox
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_ORGANIZATION_ID=
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=daytona-small

# Nosana one-shot GPU scoring job
NOSANA_API_KEY=
NOSANA_MARKET=
NOSANA_SCORE_IMAGE=
NOSANA_SCORE_CMD=python /app/score.py
NOSANA_JOB_TIMEOUT=120
NOSANA_POLL_ATTEMPTS=6
NOSANA_POLL_INTERVAL_MS=2000
